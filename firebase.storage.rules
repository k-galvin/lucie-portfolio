rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Rules for artwork images and files
    match /artwork/{allPaths=**} {
      // Establish public read access for all users
      allow read: if true;
      
      // Write protection aligned with Firestore admin logic
      allow write: if request.auth != null && (
        request.auth.uid == '4oY0H5lnPnUFkVdON7cFlOIlWLK2' || 
        request.auth.token.admin == true ||
        request.auth.token.email.matches('(?i)studio@luciegalvin.com')
      );
    }
  }
}
