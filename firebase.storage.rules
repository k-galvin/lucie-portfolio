rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Rules for artwork images and files
    match /artwork/{allPaths=**} {
      // Establish public read access for all users
      allow read: if true;
      
      // Strict write protection locked down to an authenticated admin UID
      allow write: if request.auth != null && request.auth.uid == 'PhKwKVAwe4N6dPvXBwLHSW4wWsg1';
    }
  }
}
