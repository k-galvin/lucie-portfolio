rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Artworks Collection Rules
    match /artworks/{artworkId} {
      // Public read access for everyone
      allow read: if true;
      // Write access locked to the authenticated administrator
      allow write: if request.auth != null && (
        request.auth.uid == '4oY0H5lnPnUFkVdON7cFlOIlWLK2' || 
        request.auth.token.admin == true ||
        request.auth.token.email.matches('(?i)studio@luciegalvin.com')
      );
    }

    // Exhibitions Collection Rules
    match /exhibitions/{exhibitionId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == '4oY0H5lnPnUFkVdON7cFlOIlWLK2' || 
        request.auth.token.admin == true ||
        request.auth.token.email.matches('(?i)studio@luciegalvin.com')
      );
    }

    // Biography Collection Rules
    match /biography/{docId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == '4oY0H5lnPnUFkVdON7cFlOIlWLK2' || 
        request.auth.token.admin == true ||
        request.auth.token.email.matches('(?i)studio@luciegalvin.com')
      );
    }

    // Settings Collection (Homepage Hero, etc)
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == '4oY0H5lnPnUFkVdON7cFlOIlWLK2' || 
        request.auth.token.admin == true ||
        request.auth.token.email.matches('(?i)studio@luciegalvin.com')
      );
    }

    // Contact Messages Collection Rules
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && (
        request.auth.uid == '4oY0H5lnPnUFkVdON7cFlOIlWLK2' || 
        request.auth.token.admin == true ||
        request.auth.token.email.matches('(?i)studio@luciegalvin.com')
      );
    }
  }
}
