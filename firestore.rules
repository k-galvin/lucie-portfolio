rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Artworks Collection Rules
    match /artworks/{artworkId} {
      // Public read access for everyone
      allow read: if true;
      // Write access locked to the authenticated administrator UID
      allow write: if request.auth != null && (request.auth.uid == 'PhKwKVAwe4N6dPvXBwLHSW4wWsg1' || request.auth.token.admin == true);
    }
    
    // Exhibitions Collection Rules
    match /exhibitions/{exhibitionId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == 'PhKwKVAwe4N6dPvXBwLHSW4wWsg1' || request.auth.token.admin == true);
    }
    
    // Biography Collection Rules
    match /biography/{docId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == 'PhKwKVAwe4N6dPvXBwLHSW4wWsg1' || request.auth.token.admin == true);
    }

    // Contact Messages Collection Rules
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && (request.auth.uid == 'PhKwKVAwe4N6dPvXBwLHSW4wWsg1' || request.auth.token.admin == true);
    }
  }
}
