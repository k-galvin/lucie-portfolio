---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Lucie Galvin | Artist Portfolio", 
  description = "Custom fine art portfolio of Lucie Galvin, featuring modern Paper Pictures, landscape paintings, and printmaking." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Optimization -->
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- OpenGraph SEO Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/lucie_landscape.png" />
    
    <!-- Twitter Card SEO Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/images/lucie_landscape.png" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet" />



    <!-- Client Router for smooth SPA transitions -->
    <ClientRouter />

    <script>
      // Disable default browser scroll restoration for SPA navigation
      if (typeof window !== 'undefined' && window.history && 'scrollRestoration' in window.history) {
        window.history.scrollRestoration = 'manual';
      }

      // Global scroll reset for Astro SPA transitions to prevent window scroll retention on mobile
      const resetScrolls = () => {
        window.scrollTo(0, 0);
        if (document.documentElement) document.documentElement.scrollTop = 0;
        if (document.body) document.body.scrollTop = 0;
        
        // Also reset any scrollable page containers
        const scrollContainers = document.querySelectorAll(
          '.about-container, .exhibition-page-container, .artworks-grid, .contact-container'
        );
        scrollContainers.forEach(container => {
          container.scrollTop = 0;
        });
      };

      document.addEventListener('astro:after-swap', resetScrolls);
      document.addEventListener('astro:page-load', resetScrolls);
    </script>
  </head>
  <body>
    <div class="app-container">
      <Header />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --font-sans: 'Outfit', sans-serif;
    --font-serif: 'Playfair Display', serif;
    --color-bg: #ffffff;
    --color-text: #111111;
    --color-text-muted: #666666;
    --color-border: #e8e8e8;
    
    /* David Hockney Color Palette */
    --color-hockney-blue: #00A3E0;
    --color-hockney-pink: #FF5B84;
    --color-hockney-green: #39B54A;
    --color-hockney-orange: #FF6C2F;
    --color-hockney-yellow: #FFD100;
    --color-hockney-magenta: #E52E71;

    --transition-speed: 0.3s;
  }

  /* CSS Reset */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    width: 100%;
    height: 100dvh;
    min-height: 100dvh;
    max-height: 100dvh;
    overflow: hidden; /* Zero vertical body scroll allowed */
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Structural shell */
  .app-container {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100dvh;
    min-height: 100dvh;
    max-height: 100dvh;
    overflow: hidden;
  }

  main {
    flex: 1 1 0%;
    min-height: 0; /* Let main shrink inside the flex-container */
    width: 100%;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* Custom Scrollbar for inner components (e.g. Exhibitions list or filters if overflowing) */
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: #e0e0e0;
    border-radius: 3px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--color-hockney-blue);
  }



  /* Typography Defaults */
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  p {
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .artwork-title {
    font-family: var(--font-serif);
    font-style: italic;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    background: none;
    border: none;
    font: inherit;
    cursor: pointer;
    outline: none;
  }

  /* Simple animations */
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .fade-in {
    animation: fadeIn var(--transition-speed) ease forwards;
  }

  .hidden {
    display: none !important;
  }

  /* About Me Page Layout Styles (Global to prevent client router dynamic stylesheet injection lag) */
  .about-container {
    width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0 auto;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow-y: auto;
  }

  .about-split {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: stretch;
    width: 100%;
    height: 52%;
    min-height: 0;
  }

  .about-text-column {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    height: 100%;
    min-height: 0;
  }

  .bio-section {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-bottom: 0.5rem;
    margin-bottom: 1.25rem;
    border-bottom: 3px solid var(--color-border);
    flex-shrink: 0;
  }

  .hockney-green-border {
    border-bottom-color: var(--color-hockney-green);
  }

  .hockney-pink-border {
    border-bottom-color: var(--color-hockney-pink);
  }

  .hockney-blue-border {
    border-bottom-color: var(--color-hockney-blue);
  }

  .bio-text {
    width: 100%;
    flex-grow: 1;
    overflow-y: auto;
    min-height: 0;
    padding-right: 0.5rem;
  }

  .bio-text p {
    font-size: 1.05rem;
    margin-bottom: 1.25rem;
    line-height: 1.75;
    color: var(--color-text);
    white-space: pre-line;
  }

  .bio-text p a {
    color: var(--color-hockney-blue);
    text-decoration: underline;
    transition: color var(--transition-speed) ease;
  }

  .bio-text p a:hover {
    color: var(--color-hockney-pink);
  }

  .bio-text p:last-child {
    margin-bottom: 0;
  }

  .bio-loading-simple {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .spinner-mini {
    width: 16px;
    height: 16px;
    border: 2px solid var(--color-border);
    border-top-color: var(--color-hockney-blue);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  /* Artist Portrait Image Column */
  .about-portrait-column {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  @keyframes global-skeleton-pulse {
    0% { background-color: #f5f5f5; }
    50% { background-color: #ededed; }
    100% { background-color: #f5f5f5; }
  }

  .artist-portrait-frame {
    width: 100%;
    height: 100%;
    max-width: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: #f5f5f5;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.06);
    animation: global-skeleton-pulse 1.5s ease-in-out infinite;
  }

  .artist-portrait-frame:has(.artist-portrait-image.loaded) {
    animation: none;
    background-color: transparent;
  }

  .artist-portrait-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.3s ease;
    opacity: 0;
  }

  .artist-portrait-image.loaded {
    opacity: 1;
  }

  .artist-portrait-frame:hover .artist-portrait-image {
    transform: scale(1.02);
  }

  /* Process Timeline Section */
  .process-section {
    width: 100%;
    height: 42%;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.25rem;
    width: 100%;
    flex-grow: 1;
    min-height: 0;
  }

  .process-card {
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    position: relative;
    height: 100%;
    min-height: 0;
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .process-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.05);
  }

  .process-img-container {
    width: 100%;
    height: 80%;
    overflow: hidden;
    position: relative;
    border-bottom: 1px solid var(--color-border);
    background-color: #f5f5f5;
    animation: global-skeleton-pulse 1.5s ease-in-out infinite;
  }

  .process-img-container:has(.process-image.loaded) {
    animation: none;
    background-color: transparent;
  }

  .process-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease, opacity 0.3s ease;
    opacity: 0;
  }

  .process-image.loaded {
    opacity: 1;
  }

  .process-card:hover .process-image {
    transform: scale(1.04);
  }

  .step-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background-color: var(--color-hockney-pink);
    color: #ffffff;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    z-index: 2;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  }

  .process-info {
    padding: 0.5rem 0.75rem;
    height: 20%;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    justify-content: flex-start;
    overflow: hidden;
  }

  .process-step-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
  }

  .process-step-desc {
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  @media (max-width: 1024px) {
    .about-container {
      height: 100%;
      max-height: 100%;
      overflow-y: auto;
      padding: 1.5rem 1.25rem 3rem 1.25rem;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      gap: 2.5rem;
    }
    .about-split {
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
      height: auto;
      min-height: auto;
      width: 100%;
    }
    .about-text-column {
      height: auto;
      min-height: auto;
      display: block;
      width: 100%;
    }
    .bio-section {
      height: auto;
      min-height: auto;
      display: block;
      width: 100%;
    }
    .bio-text {
      height: 350px;
      overflow-y: auto;
      padding-right: 0.5rem;
    }
    .about-portrait-column {
      height: auto;
      min-height: auto;
      display: block;
      width: 100%;
    }
    .artist-portrait-frame {
      width: 100%;
      max-width: 100%;
      aspect-ratio: 3/2;
      height: auto;
    }
    .artist-portrait-image {
      width: 100%;
      height: auto;
      aspect-ratio: 3/2;
      object-fit: cover;
    }
    .process-section {
      height: auto;
      min-height: auto;
      padding-top: 2rem;
      display: block;
      width: 100%;
    }
    .process-grid {
      grid-template-columns: repeat(2, 1fr);
      height: auto;
      min-height: auto;
      gap: 1.5rem;
      display: grid;
    }
    .process-card {
      height: auto;
      min-height: auto;
      display: flex;
      flex-direction: column;
    }
    .process-img-container {
      height: auto;
      aspect-ratio: 4/3;
      width: 100%;
    }
    .process-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .process-info {
      height: auto;
      padding: 1.25rem 1rem;
      gap: 0.5rem;
      display: flex;
      flex-direction: column;
    }
    .process-step-desc {
      -webkit-line-clamp: none;
    }
    .section-title {
      font-size: 1.35rem;
      margin-bottom: 1.25rem;
    }
  }

  @media (max-width: 768px) {
    .process-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 1.25rem;
      padding: 0.5rem 0 1.5rem 0;
      margin: 0;
      scrollbar-width: thin;
      -webkit-overflow-scrolling: touch;
      height: auto;
      scroll-padding: 0;
    }
    
    .process-card {
      flex: 0 0 270px;
      scroll-snap-align: start;
      height: auto;
    }

    .process-img-container {
      aspect-ratio: 4/3;
      height: auto;
    }

    .process-info {
      height: auto;
      padding: 1rem;
    }
  }

  /* Unlocks window/body scrolling for non-slideshow pages on tablet/mobile screens */
  /* to allow native iOS/system tap-status-bar-to-scroll-to-top behavior */
  @media (max-width: 1024px) {
    html:not(:has(#hero-slideshow)),
    html:not(:has(#hero-slideshow)) body {
      height: auto !important;
      min-height: 100% !important;
      max-height: none !important;
      overflow-y: auto !important;
    }
    
    html:not(:has(#hero-slideshow)) .app-container {
      height: auto !important;
      min-height: 100dvh !important;
      max-height: none !important;
      overflow: visible !important;
    }
    
    html:not(:has(#hero-slideshow)) main {
      height: auto !important;
      min-height: auto !important;
      max-height: none !important;
      overflow: visible !important;
      flex: none !important;
      display: block !important;
    }

    /* Override page wrapper heights and scrolls to let the page contents stretch naturally */
    html:not(:has(#hero-slideshow)) .artworks-container,
    html:not(:has(#hero-slideshow)) .about-container,
    html:not(:has(#hero-slideshow)) .exhibition-page-container,
    html:not(:has(#hero-slideshow)) .contact-container {
      height: auto !important;
      max-height: none !important;
      overflow: visible !important;
    }

    html:not(:has(#hero-slideshow)) .grid-wrapper,
    html:not(:has(#hero-slideshow)) .bio-text {
      height: auto !important;
      max-height: none !important;
      overflow-y: visible !important;
    }
  }
</style>
