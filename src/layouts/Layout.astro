---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Lucie Galvin | Artist Portfolio", 
  description = "Custom fine art portfolio of Lucie Galvin, featuring modern Paper Pictures, landscape paintings, and printmaking." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Optimization -->
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet" />



    <!-- Client Router for smooth SPA transitions -->
    <ClientRouter />

    <script>
      // Disable default browser scroll restoration for SPA navigation
      if (typeof window !== 'undefined' && window.history && 'scrollRestoration' in window.history) {
        window.history.scrollRestoration = 'manual';
      }

      // Global scroll reset for Astro SPA transitions to prevent window scroll retention on mobile
      const resetScrolls = () => {
        window.scrollTo(0, 0);
        if (document.documentElement) document.documentElement.scrollTop = 0;
        if (document.body) document.body.scrollTop = 0;
        
        // Also reset any scrollable page containers
        const scrollContainers = document.querySelectorAll(
          '.about-container, .exhibition-page-container, .artworks-grid, .contact-container'
        );
        scrollContainers.forEach(container => {
          container.scrollTop = 0;
        });
      };

      document.addEventListener('astro:after-swap', resetScrolls);
      document.addEventListener('astro:page-load', resetScrolls);
    </script>
  </head>
  <body>
    <div class="app-container">
      <Header />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --font-sans: 'Outfit', sans-serif;
    --font-serif: 'Playfair Display', serif;
    --color-bg: #ffffff;
    --color-text: #111111;
    --color-text-muted: #666666;
    --color-border: #e8e8e8;
    
    /* David Hockney Color Palette */
    --color-hockney-blue: #00A3E0;
    --color-hockney-pink: #FF5B84;
    --color-hockney-green: #39B54A;
    --color-hockney-orange: #FF6C2F;
    --color-hockney-yellow: #FFD100;
    --color-hockney-magenta: #E52E71;

    --transition-speed: 0.3s;
  }

  /* CSS Reset */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    width: 100%;
    height: 100dvh;
    min-height: 100dvh;
    max-height: 100dvh;
    overflow: hidden; /* Zero vertical body scroll allowed */
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Structural shell */
  .app-container {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100dvh;
    min-height: 100dvh;
    max-height: 100dvh;
    overflow: hidden;
  }

  main {
    flex: 1 1 0%;
    min-height: 0; /* Let main shrink inside the flex-container */
    width: 100%;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* Custom Scrollbar for inner components (e.g. Exhibitions list or filters if overflowing) */
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: #e0e0e0;
    border-radius: 3px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--color-hockney-blue);
  }



  /* Typography Defaults */
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  p {
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .artwork-title {
    font-family: var(--font-serif);
    font-style: italic;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    background: none;
    border: none;
    font: inherit;
    cursor: pointer;
    outline: none;
  }

  /* Simple animations */
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .fade-in {
    animation: fadeIn var(--transition-speed) ease forwards;
  }

  .hidden {
    display: none !important;
  }

  /* Exhibitions Page Layout Styles (Global to prevent client router dynamic stylesheet injection lag) */
  .exhibition-page-container {
    width: 100%;
    height: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 2rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .status-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 1rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid var(--color-border);
    border-top-color: var(--color-hockney-blue);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .exh-split-layout {
    display: grid;
    grid-template-columns: minmax(300px, 450px) 1fr;
    gap: 4rem;
    align-items: center;
    width: 100%;
    margin: auto 0;
  }

  .exh-visual-column {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .exh-image-wrapper {
    width: 100%;
    aspect-ratio: 3 / 4;
    border: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
    background-color: #fafafa;
  }

  .exh-featured-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .exh-image-wrapper:hover .exh-featured-image {
    transform: scale(1.03);
  }

  .exh-details-column {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .details-content-wrapper {
    width: 100%;
    max-width: 650px;
  }

  .exh-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-hockney-blue);
    margin-bottom: 0.75rem;
    display: inline-block;
  }

  .exh-main-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4.5vh, 3.5rem);
    font-style: italic;
    font-weight: 600;
    line-height: 1.1;
    color: var(--color-text);
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .exh-meta-block {
    margin-bottom: 1.5rem;
  }

  .exh-date {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-hockney-green);
    margin-bottom: 0.25rem;
  }

  .exh-location {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .exh-location strong {
    color: var(--color-text);
  }

  .exh-divider {
    height: 2px;
    width: 80px;
    background-color: var(--color-hockney-pink);
    margin-bottom: 1.5rem;
  }

  .exh-essay p {
    font-size: clamp(0.85rem, 1.8vh, 0.98rem);
    line-height: 1.65;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  /* Responsive Tablet & Mobile Layouts */
  @media (min-width: 681px) and (max-width: 900px) {
    .exhibition-page-container {
      padding: 2rem 1.5rem;
      overflow-y: auto;
      justify-content: flex-start;
      height: 100% !important;
    }

    .exh-split-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      margin: auto 0;
    }

    .exh-visual-column {
      max-width: 440px;
      margin: 0 auto;
    }

    .exh-details-column {
      width: 100%;
    }

    .details-content-wrapper {
      max-width: 520px !important;
      margin: 0 auto;
    }

    .exh-main-title {
      font-size: clamp(1.8rem, 3.5vh, 2.6rem);
    }

    .exh-essay p {
      font-size: 0.92rem;
    }
  }

  @media (max-width: 680px) {
    .exhibition-page-container {
      padding: 1.5rem 1rem 3rem 1rem;
      overflow-y: auto;
      justify-content: flex-start;
      height: 100% !important;
    }

    .exh-split-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      margin: 0;
    }

    .exh-visual-column {
      max-width: 320px;
      margin: 0 auto;
    }

    .exh-details-column {
      width: 100%;
    }

    .details-content-wrapper {
      max-width: 100%;
    }

    .exh-main-title {
      font-size: 1.8rem;
    }

    .exh-essay p {
      margin-bottom: 1rem;
    }
  }

  /* About Me Page Layout Styles (Global to prevent client router dynamic stylesheet injection lag) */
  .about-container {
    width: 100%;
    height: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 2rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .about-split {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    height: 100%;
    min-height: 0;
  }

  .about-text-column {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }

  .scrollable-content {
    flex: 1;
    overflow-y: auto;
    padding-right: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .bio-section {
    margin: auto 0;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 3px solid var(--color-border);
  }

  .hockney-green-border {
    border-bottom-color: var(--color-hockney-green);
  }

  .bio-text p {
    font-size: clamp(0.85rem, 1.8vh, 0.98rem);
    margin-bottom: 1.5rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    white-space: pre-line;
  }

  .bio-text p:last-child {
    margin-bottom: 0;
  }

  .bio-loading-simple {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .spinner-mini {
    width: 16px;
    height: 16px;
    border: 2px solid var(--color-border);
    border-top-color: var(--color-hockney-blue);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  /* Collage Layout */
  .about-collage-column {
    height: 100%;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .collage-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 1rem;
    width: 100%;
    height: 100%;
    max-height: 580px;
  }

  .collage-item {
    border: 1px solid var(--color-border);
    overflow: hidden;
    position: relative;
    background-color: #fafafa;
  }

  .portrait-item {
    grid-row: 1 / span 2;
    grid-column: 1;
  }

  .studio-item {
    grid-row: 1;
    grid-column: 2;
  }

  .landscape-item {
    grid-row: 2;
    grid-column: 2;
  }

  .collage-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .collage-item:hover .collage-image {
    transform: scale(1.03);
  }

  @media (max-width: 900px) {
    .about-container {
      padding: 1.25rem 1rem;
      overflow-y: auto;
    }
    .about-split {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      height: auto;
      min-height: auto;
    }
    .about-text-column {
      display: block;
      height: auto;
      min-height: auto;
      flex: none;
    }
    .scrollable-content {
      display: block;
      overflow-y: visible;
      padding: 0;
      height: auto;
      min-height: auto;
      flex: none;
    }
    .bio-section {
      margin: 0;
    }
    .about-collage-column {
      display: block;
      height: auto;
      min-height: auto;
      flex: none;
    }
    .collage-grid {
      height: auto;
      aspect-ratio: 1.35;
      max-height: none;
    }
    .section-title {
      font-size: 1.25rem;
      margin-bottom: 1rem;
    }
  }
</style>
