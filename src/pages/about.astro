---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About | Lucie Galvin">
  <div class="about-container">
    
    <!-- Biography / Portrait Top Row -->
    <div class="about-split">
      
      <!-- Text Information Column -->
      <section class="about-text-column" aria-label="About">
        <div class="bio-section fade-in">
          <h2 class="section-title hockney-green-border">About</h2>
          
          <div class="bio-text" id="bio-text-container">
            <div id="bio-loading" class="bio-loading-simple">
              <div class="spinner-mini"></div>
              <span>Loading biography...</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Large Landscape Artist Portrait -->
      <section class="about-portrait-column" aria-label="Artist portrait">
        <div class="artist-portrait-frame fade-in">
          <img alt="Lucie Galvin in her art studio" class="artist-portrait-image" loading="eager" fetchpriority="high" />
        </div>
      </section>

    </div>

    <!-- Artwork Process Bottom Row -->
    <section class="process-section fade-in" aria-label="Creation process">
      <h2 class="section-title hockney-blue-border">Process: Anatomy of a Paper Picture</h2>
      <div class="process-grid">
        
        <!-- Stage 1 -->
        <div class="process-card">
          <span class="step-badge">01</span>
          <div class="process-img-container">
            <img alt="Stage 1: Conceptual sketching and composition planning" class="process-image" loading="lazy" />
          </div>
          <div class="process-info">
            <h4 class="process-step-title">1. Sketching</h4>
          </div>
        </div>

        <!-- Stage 2 -->
        <div class="process-card">
          <span class="step-badge">02</span>
          <div class="process-img-container">
            <img alt="Stage 2: Painting custom sheets of paper with textured colors" class="process-image" loading="lazy" />
          </div>
          <div class="process-info">
            <h4 class="process-step-title">2. Piecing</h4>
          </div>
        </div>

        <!-- Stage 3 -->
        <div class="process-card">
          <span class="step-badge">03</span>
          <div class="process-img-container">
            <img alt="Stage 3: Cutting and fitting base collage blocks" class="process-image" loading="lazy" />
          </div>
          <div class="process-info">
            <h4 class="process-step-title">3. Blocking</h4>
          </div>
        </div>

        <!-- Stage 4 -->
        <div class="process-card">
          <span class="step-badge">04</span>
          <div class="process-img-container">
            <img alt="Stage 4: Adding detail layering and shadows" class="process-image" loading="lazy" />
          </div>
          <div class="process-info">
            <h4 class="process-step-title">4. Detail</h4>
          </div>
        </div>

        <!-- Stage 5 -->
        <div class="process-card">
          <span class="step-badge">05</span>
          <div class="process-img-container">
            <img alt="Stage 5: The completed artwork framed and mounted" class="process-image" loading="lazy" />
          </div>
          <div class="process-info">
            <h4 class="process-step-title">5. Installation</h4>
          </div>
        </div>

      </div>
    </section>

  </div>
</Layout>



<script>
  import { db } from '../lib/firebase';
  import { doc, getDoc } from 'firebase/firestore';
  import { splitBioParagraphs, parseMarkdownLinks } from '../lib/utils';

  async function loadLiveBiography() {
    const container = document.getElementById('bio-text-container');
    if (!container) return;

    try {
      const docRef = doc(db, 'biography', 'main');
      const docSnap = await getDoc(docRef);
      
      if (docSnap.exists()) {
        const data = docSnap.data();
        const bioText = data.text || '';

        if (bioText) {
          const paragraphs = splitBioParagraphs(bioText);
          
          if (paragraphs.length > 0) {
            // Replace the spinner with actual content
            container.innerHTML = paragraphs
              .map((pText: string) => `<p>${parseMarkdownLinks(pText)}</p>`)
              .join('');
          }
        }
      } else {
        container.innerHTML = '<p>Biography currently unavailable.</p>';
      }
    } catch (err) {
      console.warn('Biography client loading failed.', err);
      container.innerHTML = '<p>Error loading biography. Please try again later.</p>';
    }
  }

  function initAboutPage() {
    loadLiveBiography();

    const portraitImg = document.querySelector('.artist-portrait-image') as HTMLImageElement;
    if (portraitImg) {
      portraitImg.addEventListener('load', () => {
        portraitImg.classList.add('loaded');
      });
      portraitImg.src = "/images/lucie_about_artist.jpeg";
      if (portraitImg.complete) {
        portraitImg.classList.add('loaded');
      }
    }

    const processImages = [
      { selector: '.process-card:nth-child(1) .process-image', src: '/images/process_1.jpeg' },
      { selector: '.process-card:nth-child(2) .process-image', src: '/images/process_2.jpeg' },
      { selector: '.process-card:nth-child(3) .process-image', src: '/images/process_3.jpeg' },
      { selector: '.process-card:nth-child(4) .process-image', src: '/images/process_4.jpeg' },
      { selector: '.process-card:nth-child(5) .process-image', src: '/images/process_5.jpeg' }
    ];

    processImages.forEach(item => {
      const img = document.querySelector(item.selector) as HTMLImageElement;
      if (img) {
        img.addEventListener('load', () => {
          img.classList.add('loaded');
        });
        img.src = item.src;
        if (img.complete) {
          img.classList.add('loaded');
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initAboutPage);
</script>
