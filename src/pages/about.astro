---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Me | Lucie Galvin">
  <div class="about-container">
    <div class="about-split">
      
      <!-- Text Information Column -->
      <section class="about-text-column" aria-label="Biography">
        <div class="scrollable-content">
          <div class="bio-section fade-in">
            <h2 class="section-title hockney-green-border">Biography</h2>
            
            <div class="bio-text" id="bio-text-container" style="min-height: 300px;">
              <div id="bio-loading" class="bio-loading-simple">
                <div class="spinner-mini"></div>
                <span>Loading biography...</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Images Collage Column -->
      <section class="about-collage-column" aria-label="Artist photos">
        <div class="collage-grid fade-in">
          <div class="collage-item portrait-item">
            <img src="/images/lucie_portrait.png" alt="Lucie Galvin in her art studio" class="collage-image" />
          </div>
          <div class="collage-item studio-item">
            <img src="/images/lucie_studio.png" alt="Artist paint work table" class="collage-image" />
          </div>
          <div class="collage-item landscape-item">
            <img src="/images/lucie_landscape.png" alt="Easel displaying landscape painting outdoors" class="collage-image" />
          </div>
        </div>
      </section>

    </div>
  </div>
</Layout>



<script>
  import { db } from '../lib/firebase';
  import { doc, getDoc } from 'firebase/firestore';

  async function loadLiveBiography() {
    const container = document.getElementById('bio-text-container');
    if (!container) return;

    try {
      const docRef = doc(db, 'biography', 'main');
      const docSnap = await getDoc(docRef);
      
      if (docSnap.exists()) {
        const data = docSnap.data();
        const bioText = data.text || '';

        if (bioText) {
          // Split by two or more newlines to identify true paragraphs
          const paragraphs = bioText.split(/\n\s*\n/).map((p: string) => p.trim()).filter((p: string) => p.length > 0);
          
          if (paragraphs.length > 0) {
            // Replace the spinner with actual content
            container.innerHTML = paragraphs
              .map((pText: string) => `<p>${pText}</p>`)
              .join('');
          }
        }
      } else {
        container.innerHTML = '<p>Biography currently unavailable.</p>';
      }
    } catch (err) {
      console.warn('Biography client loading failed.', err);
      container.innerHTML = '<p>Error loading biography. Please try again later.</p>';
    }
  }

  function initAboutPage() {
    loadLiveBiography();
  }

  document.addEventListener('astro:page-load', initAboutPage);
</script>
