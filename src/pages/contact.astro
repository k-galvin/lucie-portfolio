---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Lucie Galvin">
  <div class="contact-container">
    
    <!-- Left Column: Artwork Image -->
    <div class="contact-artwork-frame fade-in">
      <div class="contact-artwork-image-wrapper">
        <img id="contact-artwork-img" alt="Riprap - Paper Picture by Lucie Galvin" class="contact-artwork-image" loading="eager" fetchpriority="high" />
        <div class="artwork-overlay">
          <div class="overlay-details">
            <h3 class="overlay-title">Riprap</h3>
            <p id="contact-artwork-medium" class="overlay-meta">Paper collage</p>
            <p id="contact-artwork-dimensions" class="overlay-meta">30 × 24 in</p>
            <p id="contact-artwork-year" class="overlay-meta">2026</p>
            <div class="overlay-footer">
              <span></span>
            </div>
            <a id="contact-artwork-print-link" href="https://www.saatchiart.com/luciegalvin" target="_blank" rel="noopener noreferrer" class="print-available-link hidden">
              Prints available
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Contact Card -->
    <div class="contact-card fade-in">
      <div class="contact-header">
        <h1 class="contact-title">Get in Touch</h1>
        <a href="mailto:studio@luciegalvin.com" class="contact-email-link">studio@luciegalvin.com</a>
        <p class="contact-subtitle">
          For inquiries about commissions, representation, or purchasing original works.
        </p>
      </div>

      <!-- Contact Form -->
      <form id="contact-form" class="contact-form">
        <input type="text" name="_honey" style="display:none" />
        <div class="form-group">
          <label for="contact-name" class="form-label">Name</label>
          <input type="text" id="contact-name" name="name" class="form-input" required />
        </div>

        <div class="form-group">
          <label for="contact-email" class="form-label">Email</label>
          <input type="email" id="contact-email" name="email" class="form-input" required />
        </div>

        <div class="form-group">
          <label for="contact-message" class="form-label">Message</label>
          <textarea id="contact-message" name="message" rows="4" class="form-textarea" required></textarea>
        </div>

        <button type="submit" id="submit-btn" class="submit-btn">
          <span class="submit-text-normal">Send Message</span>
          <span class="submit-text-loading hidden">Sending...</span>
        </button>

        <!-- Message Status Triggers -->
        <div id="status-success" class="status-message success hidden">
          Your message has been sent successfully!
        </div>

        <div id="status-error" class="status-message error hidden">
          An error occurred. Please try again later.
        </div>
      </form>
    </div>
  </div>
</Layout>

<style>
  .contact-container {
    width: 100%;
    height: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
    overflow-y: auto;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    grid-template-areas: "form image";
    gap: 5rem;
    align-items: center;
    justify-content: center;
  }

  .contact-artwork-frame {
    grid-area: image;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    min-width: 0;
    cursor: pointer;
  }

  @keyframes contact-skeleton-pulse {
    0% { background-color: #f5f5f5; }
    50% { background-color: #ededed; }
    100% { background-color: #f5f5f5; }
  }

  .contact-artwork-image-wrapper {
    width: 100%;
    aspect-ratio: 1.25; /* Matches the 5:4 aspect ratio of riprap.jpg */
    border: 1px solid var(--color-border);
    background-color: #f5f5f5;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.04);
    overflow: hidden;
    position: relative;
    animation: contact-skeleton-pulse 1.5s ease-in-out infinite;
  }

  .contact-artwork-image-wrapper:has(.contact-artwork-image.loaded) {
    animation: none;
    background-color: transparent;
  }

  .contact-artwork-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease, opacity 0.3s ease;
    opacity: 0;
  }

  .contact-artwork-image.loaded {
    opacity: 1;
  }

  .contact-artwork-frame:hover .contact-artwork-image {
    transform: scale(1.03);
  }

  .artwork-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.95);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  .contact-artwork-frame:hover .artwork-overlay {
    opacity: 1;
  }

  .overlay-title {
    font-size: 0.95rem;
    font-family: var(--font-sans);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
    color: var(--color-text);
    text-align: left;
  }

  .overlay-meta {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
    font-weight: 500;
    text-align: left;
  }

  .overlay-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }

  .print-available-link {
    display: inline-block;
    width: fit-content;
    text-align: left;
    margin-top: 0.75rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: none;
    letter-spacing: 0.05em;
    color: var(--color-text);
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .print-available-link:hover {
    color: var(--color-hockney-pink);
  }

  .contact-card {
    grid-area: form;
    width: 100%;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 2.5rem 3rem;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.01);
  }

  .contact-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .contact-title {
    font-size: 1.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .contact-email-link {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-hockney-blue);
    text-decoration: none;
    transition: color 0.2s ease;
    display: block;
    margin-bottom: 0.75rem;
  }

  .contact-email-link:hover {
    color: var(--color-hockney-pink);
    text-decoration: underline;
  }

  .contact-subtitle {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .form-input, .form-textarea {
    width: 100%;
    background-color: transparent;
    border: none;
    border-bottom: 1.5px solid var(--color-border);
    padding: 0.5rem 0;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--color-text);
    border-radius: 0;
    transition: border-color 0.3s ease;
  }

  .form-input:focus, .form-textarea:focus {
    outline: none;
    border-bottom-color: var(--color-hockney-blue);
  }

  .form-input:hover:not(:focus), .form-textarea:hover:not(:focus) {
    border-bottom-color: var(--color-hockney-pink);
  }

  .form-textarea {
    resize: none;
  }

  .submit-btn {
    width: 100%;
    padding: 0.85rem;
    background-color: var(--color-text);
    color: var(--color-bg);
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: background-color 0.3s ease, transform 0.2s ease;
    margin-top: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .submit-btn:hover {
    background-color: var(--color-hockney-pink);
    transform: translateY(-1px);
  }

  .submit-btn:active {
    transform: translateY(0);
  }

  .submit-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .hidden {
    display: none !important;
  }

  .status-message {
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    font-weight: 500;
    text-align: center;
    margin-top: 0.5rem;
    animation: fadeIn 0.3s ease forwards;
  }

  .status-message.success {
    background-color: rgba(57, 181, 74, 0.08);
    color: var(--color-hockney-green);
    border: 1px solid var(--color-hockney-green);
  }

  .status-message.error {
    background-color: rgba(255, 91, 132, 0.08);
    color: var(--color-hockney-pink);
    border: 1px solid var(--color-hockney-pink);
  }

  @media (max-width: 1024px) {
    .contact-container {
      grid-template-columns: 1fr;
      grid-template-areas: 
        "form"
        "image";
      gap: 3rem;
      padding: 3rem 2rem;
    }

    .contact-artwork-frame {
      max-width: 580px;
      margin: 0 auto;
    }

    .contact-card {
      max-width: 580px;
      margin: 0 auto;
    }
  }

  @media (max-width: 768px) {
    .contact-container {
      padding: 2rem 1rem;
      gap: 2rem;
    }

    .contact-card {
      padding: 1.5rem 0;
      border: none;
      box-shadow: none;
    }

    .contact-title {
      font-size: 1.4rem;
    }
  }
</style>

<script>
  import { db } from '../lib/firebase';
  import { collection, addDoc, serverTimestamp, query, where, getDocs } from 'firebase/firestore';
  import { validateEmail, shouldBlockSubmit, formatDimensions, getOptimizedImageUrl } from '../lib/utils';

  async function loadContactArtwork() {
    try {
      const q = query(collection(db, 'artworks'), where('title', '==', 'Riprap'));
      const querySnapshot = await getDocs(q);

      if (!querySnapshot.empty) {
        const docSnap = querySnapshot.docs[0];
        const data = docSnap.data();

        const imgEl = document.getElementById('contact-artwork-img') as HTMLImageElement;
        const mediumEl = document.getElementById('contact-artwork-medium');
        const dimensionsEl = document.getElementById('contact-artwork-dimensions');
        const yearEl = document.getElementById('contact-artwork-year');
        const printLinkEl = document.getElementById('contact-artwork-print-link') as HTMLAnchorElement;

        if (imgEl && data.imageUrl) {
          imgEl.classList.remove('loaded');
          imgEl.src = getOptimizedImageUrl(data.imageUrl, 1000);
          imgEl.alt = data.title || 'Riprap';
        }
        if (mediumEl && data.medium) {
          mediumEl.textContent = data.medium;
        }
        
        if (dimensionsEl) {
          const width = data.dimensions?.width || '';
          const height = data.dimensions?.height || '';
          const unit = data.dimensions?.unit || 'in';
          const dimString = formatDimensions(width, height, unit);
          if (dimString) {
            dimensionsEl.textContent = dimString;
            dimensionsEl.classList.remove('hidden');
          } else {
            dimensionsEl.classList.add('hidden');
          }
        }

        if (yearEl && data.year) {
          yearEl.textContent = data.year.toString();
        }

        if (printLinkEl) {
          if (data.isPrint && data.printLink) {
            printLinkEl.href = data.printLink;
            printLinkEl.classList.remove('hidden');
          } else {
            printLinkEl.classList.add('hidden');
          }
        }
      }
    } catch (err) {
      console.warn('Failed to load Riprap artwork from database.', err);
    }
  }

  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    if (!form) return;

    const btnSubmit = document.getElementById('submit-btn') as HTMLButtonElement;
    const txtNormal = btnSubmit?.querySelector('.submit-text-normal');
    const txtLoading = btnSubmit?.querySelector('.submit-text-loading');
    const statusSuccess = document.getElementById('status-success');
    const statusError = document.getElementById('status-error');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Clear statuses
      statusSuccess?.classList.add('hidden');
      statusError?.classList.add('hidden');

      // Loading State
      if (btnSubmit) btnSubmit.disabled = true;
      txtNormal?.classList.add('hidden');
      txtLoading?.classList.remove('hidden');

      try {
        const nameInput = document.getElementById('contact-name') as HTMLInputElement;
        const emailInput = document.getElementById('contact-email') as HTMLInputElement;
        const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement;
        const honeyInput = form.querySelector('input[name="_honey"]') as HTMLInputElement;

        const nameVal = nameInput?.value || '';
        const emailVal = emailInput?.value || '';
        const messageVal = messageInput?.value || '';
        const honeyVal = honeyInput?.value || '';

        // Standard validation check
        if (emailInput && (!emailInput.checkValidity() || !validateEmail(emailVal))) {
          emailInput.reportValidity();
          return;
        }

        // 1. Spam prevention (Honeypot)
        if (shouldBlockSubmit(honeyVal)) {
          // Silently drop spam submission and simulate success to satisfy bots
          statusSuccess?.classList.remove('hidden');
          form.reset();
          return;
        }

        // 2. Submit backup to Firestore database
        await addDoc(collection(db, 'messages'), {
          name: nameVal,
          email: emailVal,
          message: messageVal,
          submittedAt: serverTimestamp()
        });

        // 2. Submit to FormSubmit.co for email forwarding
        const response = await fetch("https://formsubmit.co/ajax/studio@luciegalvin.com", {
          method: "POST",
          headers: { 
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            name: nameVal,
            email: emailVal,
            message: messageVal,
            _honey: honeyVal,
            _captcha: "false",
            _subject: `New contact from ${nameVal}`
          })
        });

        if (response.ok) {
          statusSuccess?.classList.remove('hidden');
          form.reset();
        } else {
          const errorData = await response.json().catch(() => ({}));
          console.error("FormSubmit Error:", errorData);
          statusError?.classList.remove('hidden');
        }
      } catch (err) {
        console.error("Contact Submission Error:", err);
        statusError?.classList.remove('hidden');
      } finally {
        // Reset states
        if (btnSubmit) btnSubmit.disabled = false;
        txtNormal?.classList.remove('hidden');
        txtLoading?.classList.add('hidden');
      }
    });
  }

  function initContactPage() {
    initContactForm();
    const imgEl = document.getElementById('contact-artwork-img') as HTMLImageElement;
    if (imgEl) {
      imgEl.addEventListener('load', () => {
        imgEl.classList.add('loaded');
      });
      imgEl.src = "/images/riprap.jpg";
      if (imgEl.complete) {
        imgEl.classList.add('loaded');
      }
    }
    loadContactArtwork();
  }

  // Bind to page transitions
  document.addEventListener('astro:page-load', initContactPage);
</script>
