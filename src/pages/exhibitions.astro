---
import Layout from '../layouts/Layout.astro';

const featuredExhibition = {
  title: 'Splashed Pools',
  dates: 'July 15 – August 30, 2026',
  venue: 'Royal Academy of Arts',
  city: 'London, UK',
  image: 'https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?w=1200&auto=format&fit=crop',
  reception: 'Opening Reception: Thursday, July 16, 2026, 6:00 PM – 9:00 PM',
  catalogue: 'A fully illustrated catalogue with an essay by curator Marcus Vance will be available during the exhibition.',
  description: 'Lucie Galvin\'s upcoming solo exhibition, Splashed Pools, represents a milestone in her artistic journey, bringing together her latest series of vibrant acrylic canvases and monumental screenprints. Inspired by the saturated light of California and David Hockney’s iconic pool paintings, the collection explores the refraction of light on moving water, framed within structural, minimalist grid landscapes. Each piece invites the viewer to contemplate the boundary between architectural representation and fluid movement, celebrating color as a primary structural element.'
};
---

<Layout title="Exhibitions | Lucie Galvin">
  <div class="exhibition-page-container">
    <div class="exh-split-layout fade-in">
      
      <!-- Left Column: Visual Exhibition Poster -->
      <div class="exh-visual-column">
        <div class="exh-image-wrapper">
          <img src={featuredExhibition.image} alt={featuredExhibition.title} id="exh-image-elem" class="exh-featured-image" />
          <div class="exh-badge-overlay">
            <span>Upcoming Exhibition</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Show Details & Bio Essay -->
      <div class="exh-details-column">
        <div class="details-content-wrapper">
          
          <span class="exh-label">Featured Exhibition</span>

          <h2 class="exh-main-title" id="exh-title-container">{featuredExhibition.title}</h2>

          <div class="exh-meta-block" id="exh-meta-container">
            <p class="exh-date" id="exh-dates-text">{featuredExhibition.dates}</p>
            <p class="exh-location">
              <strong id="exh-venue-text">{featuredExhibition.venue}</strong> — 
              <span id="exh-city-text">{featuredExhibition.city}</span>
            </p>
          </div>

          <div class="exh-divider"></div>

          <div class="exh-essay" id="exh-essay-container">
            <p>{featuredExhibition.description}</p>
          </div>

          <div class="exh-additional-info" id="exh-info-container">
            <div class="info-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="info-icon icon-pink">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <p id="exh-reception-text">{featuredExhibition.reception}</p>
            </div>
            
            <div class="info-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="info-icon icon-blue">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              </svg>
              <p id="exh-catalogue-text">{featuredExhibition.catalogue}</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</Layout>

<style>
  .exhibition-page-container {
    width: 100%;
    height: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 2rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .exh-split-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    height: 100%;
    max-height: 700px; /* Force bounds layout */
    min-height: 0;
    align-items: center;
  }

  .exh-visual-column {
    height: 100%;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .exh-image-wrapper {
    width: 100%;
    height: 100%;
    max-height: 600px;
    border: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .exh-featured-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .exh-image-wrapper:hover .exh-featured-image {
    transform: scale(1.03);
  }

  .exh-badge-overlay {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    background-color: var(--color-hockney-pink);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.85rem;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }

  .exh-details-column {
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-right: 2rem;
  }

  .details-content-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .exh-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-hockney-blue);
    margin-bottom: 0.75rem;
    display: inline-block;
  }

  .exh-main-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4.5vh, 3.5rem);
    font-style: italic;
    font-weight: 600;
    line-height: 1.1;
    color: var(--color-text);
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .exh-meta-block {
    margin-bottom: 1.5rem;
  }

  .exh-date {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-hockney-green);
    margin-bottom: 0.25rem;
  }

  .exh-location {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .exh-location strong {
    color: var(--color-text);
  }

  .exh-divider {
    height: 2px;
    width: 80px;
    background-color: var(--color-hockney-pink);
    margin-bottom: 1.5rem;
  }

  .exh-essay p {
    font-size: clamp(0.85rem, 1.8vh, 0.98rem);
    line-height: 1.65;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .exh-additional-info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }

  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .info-icon {
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .icon-pink {
    color: var(--color-hockney-pink);
  }

  .icon-blue {
    color: var(--color-hockney-blue);
  }

  .info-item p {
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .exhibition-page-container {
      padding: 1.5rem 1rem 3rem 1rem;
      overflow-y: auto;
      justify-content: flex-start; /* Avoid top overflow clipping */
    }
    .exh-split-layout {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      max-height: none;
      height: auto;
    }
    .exh-visual-column {
      height: 250px;
      flex-shrink: 0;
    }
    .exh-details-column {
      height: auto;
      padding-right: 0;
    }
    .exh-main-title {
      font-size: 1.8rem;
    }
    .exh-essay p {
      margin-bottom: 1rem;
    }
  }
</style>

<script>
  import { db } from '../lib/firebase';
  import { doc, getDoc } from 'firebase/firestore';

  async function loadLiveExhibition() {
    const imgElem = document.getElementById('exh-image-elem') as HTMLImageElement;
    const titleContainer = document.getElementById('exh-title-container');
    const datesText = document.getElementById('exh-dates-text');
    const venueText = document.getElementById('exh-venue-text');
    const cityText = document.getElementById('exh-city-text');
    const essayContainer = document.getElementById('exh-essay-container');
    const receptionText = document.getElementById('exh-reception-text');
    const catalogueText = document.getElementById('exh-catalogue-text');

    try {
      const docRef = doc(db, 'exhibitions', 'featured');
      const docSnap = await getDoc(docRef);

      if (docSnap.exists()) {
        const data = docSnap.data();

        // 1. Image
        if (data.image && imgElem) {
          imgElem.src = data.image;
        }

        // 2. Title
        if (data.title && titleContainer) {
          titleContainer.textContent = data.title;
        }

        // 3. Meta Dates & Location
        if (data.dates && datesText) datesText.textContent = data.dates;
        if (data.venue && venueText) venueText.textContent = data.venue;
        if (data.city && cityText) cityText.textContent = data.city;

        // 4. Essay Description
        if (data.description && essayContainer) {
          essayContainer.innerHTML = `<p>${data.description}</p>`;
        }

        // 5. Reception & Catalogue Info Block
        if (data.reception && receptionText) receptionText.textContent = data.reception;
        if (data.catalogue && catalogueText) catalogueText.textContent = data.catalogue;
      }
    } catch (err) {
      console.warn('Exhibition client loading failed, fell back to static HTML.', err);
    }
  }

  // Load exhibition
  document.addEventListener('astro:page-load', loadLiveExhibition);
</script>
