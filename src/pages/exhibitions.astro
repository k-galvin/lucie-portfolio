---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Exhibitions | Lucie Galvin">
  <div id="exh-page-container" class="exhibition-page-container hidden">
    <div class="exh-split-layout fade-in">
      
      <!-- Left Column: Visual Exhibition Poster -->
      <div class="exh-visual-column">
        <div class="exh-image-wrapper">
          <img src="" alt="" id="exh-image-elem" class="exh-featured-image" />
        </div>
      </div>

      <!-- Right Column: Show Details & Bio Essay -->
      <div class="exh-details-column">
        <div class="details-content-wrapper">
          
          <span class="exh-label">Featured Exhibition</span>

          <h2 class="exh-main-title" id="exh-title-container">Loading...</h2>

          <div class="exh-meta-block" id="exh-meta-container">
            <p class="exh-date" id="exh-dates-text"></p>
            <p class="exh-location">
              <strong id="exh-venue-text"></strong>
              <span id="exh-city-divider" class="hidden"> — </span>
              <span id="exh-city-text"></span>
            </p>
          </div>

          <div class="exh-divider"></div>

          <div class="exh-essay" id="exh-essay-container">
            <!-- Populated from Firebase -->
          </div>

        </div>
      </div>

    </div>
  </div>

  <div id="exh-loading-panel" class="status-panel">
    <div class="spinner"></div>
    <p>Loading exhibition details...</p>
  </div>
</Layout>



<script>
  import { db } from '../lib/firebase';
  import { doc, getDoc } from 'firebase/firestore';

  interface Exhibition {
    title?: string;
    dates?: string;
    venue?: string;
    city?: string;
    description?: string;
    image?: string;
  }

  let loaded = false;

  async function loadLiveExhibition() {
    const pageContainer = document.getElementById('exh-page-container');
    if (!pageContainer) {
      loaded = false; // Reset loaded flag if we navigated away
      return;
    }

    if (loaded) return; // Prevent double load
    loaded = true;

    const loadingPanel = document.getElementById('exh-loading-panel');
    const imgElem = document.getElementById('exh-image-elem') as HTMLImageElement;
    const titleContainer = document.getElementById('exh-title-container');
    const datesText = document.getElementById('exh-dates-text');
    const venueText = document.getElementById('exh-venue-text');
    const cityText = document.getElementById('exh-city-text');
    const cityDivider = document.getElementById('exh-city-divider');
    const essayContainer = document.getElementById('exh-essay-container');

    try {
      const docRef = doc(db, 'exhibitions', 'featured');
      const docSnap = await getDoc(docRef);

      if (docSnap.exists()) {
        const data = docSnap.data() as Exhibition;

        // 1. Image
        if (imgElem) {
          if (data.image) {
            imgElem.src = data.image;
            imgElem.alt = data.title || 'Exhibition Poster';
          } else {
            imgElem.src = 'https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?w=1200&auto=format&fit=crop';
          }
        }

        // 2. Title
        if (titleContainer) {
          titleContainer.textContent = data.title || 'Exhibition Title';
        }

        // 3. Meta Dates & Location
        if (datesText) datesText.textContent = data.dates || '';
        if (venueText) venueText.textContent = data.venue || '';
        if (cityText) cityText.textContent = data.city || '';
        if (cityDivider && data.venue && data.city) cityDivider.classList.remove('hidden');

        // 4. Essay Description
        if (essayContainer) {
          essayContainer.innerHTML = `<p>${data.description || 'Details coming soon...'}</p>`;
        }

        // Show Page
        loadingPanel?.classList.add('hidden');
        pageContainer?.classList.remove('hidden');
      } else {
        if (titleContainer) titleContainer.textContent = 'No Featured Exhibition';
        loadingPanel?.classList.add('hidden');
        pageContainer?.classList.remove('hidden');
      }
    } catch (err) {
      console.warn('Exhibition client loading failed.', err);
      if (titleContainer) titleContainer.textContent = 'Unable to Load Exhibition';
      if (essayContainer) {
        essayContainer.innerHTML = '<p style="color: var(--color-hockney-pink); font-weight: 600;">Unable to connect to the database. Please check your internet connection and try again.</p>';
      }
      loadingPanel?.classList.add('hidden');
      pageContainer?.classList.remove('hidden');
    }
  }

  // Run immediately in case the script executes after astro:page-load has already fired
  loadLiveExhibition();

  // Listen for subsequent transitions
  document.addEventListener('astro:page-load', loadLiveExhibition);</script>
