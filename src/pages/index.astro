---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div id="hero-slideshow" class="hero-slideshow">
    <!-- Hydrated from Firebase -->
    <div id="hero-loading" class="hero-loading">
      <div class="spinner"></div>
    </div>
  </div>
</Layout>

<style is:global>
  .hero-slideshow {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    background-color: #000;
  }

  .hero-loading {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #fcfcfc;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid #eee;
    border-top-color: var(--color-hockney-blue);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    z-index: 1;
    transition: opacity 1.2s ease-in-out;
    display: flex;
    align-items: flex-end;
  }

  .slide.active {
    opacity: 1;
    z-index: 2;
  }

  .slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.85);
    transition: transform 8s ease;
  }

  .slide.active .slide-image {
    transform: scale(1.05);
  }

  .slide-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 6% 8%;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 100%);
    color: #ffffff;
    z-index: 3;
    pointer-events: none;
  }

  .slide-content {
    max-width: 650px;
    pointer-events: auto;
  }

  .slide-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.5rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 10px rgba(0,0,0,0.2);
  }

  .slide-subtitle {
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    font-weight: 300;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 1.5rem;
    text-shadow: 0 1px 5px rgba(0,0,0,0.3);
  }

  .slide-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #ffffff;
    background-color: var(--color-hockney-pink);
    padding: 0.85rem 1.75rem;
    border-radius: 0;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .slide-cta:hover {
    background-color: var(--color-hockney-blue);
    transform: translateY(-2px);
  }

  .cta-arrow {
    transition: transform 0.2s ease;
  }

  .slide-cta:hover .cta-arrow {
    transform: translateX(4px);
  }

  .slider-controls {
    position: absolute;
    bottom: 2.5rem;
    right: 3rem;
    display: flex;
    gap: 0.75rem;
    z-index: 10;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.4);
    transition: background-color 0.3s ease, transform 0.2s ease;
    cursor: pointer;
  }

  .dot.active {
    background-color: #ffffff;
    transform: scale(1.3);
  }

  .dot:hover {
    background-color: var(--color-hockney-yellow);
  }

  @media (max-width: 768px) {
    .slide-overlay {
      padding: 2.5rem 1.5rem;
    }
    .slider-controls {
      bottom: 1.5rem;
      right: 1.5rem;
    }
    .slide-cta {
      padding: 0.6rem 1.25rem;
      font-size: 0.8rem;
    }
  }
</style>

<script>
  import { db } from '../lib/firebase';
  import { doc, getDoc } from 'firebase/firestore';

  async function initHeroSlider() {
    const slideshow = document.getElementById('hero-slideshow');
    if (!slideshow) return;

    try {
      const docRef = doc(db, 'settings', 'homepage');
      const docSnap = await getDoc(docRef);
      
      let slidesData = [];
      
      if (docSnap.exists()) {
        const data = docSnap.data();
        slidesData = data.heroSlides || [];
      }

      if (slidesData.length === 0) {
        // Fallback if no settings yet
        slideshow.innerHTML = `
          <div class="slide active">
            <img src="/images/lucie_portrait.png" alt="Lucie Galvin" class="slide-image" />
            <div class="slide-overlay">
              <div class="slide-content">
                <h2 class="slide-title">Lucie Galvin</h2>
                <p class="slide-subtitle">Paper Pictures, Drawing & Printmaking</p>
                <a href="/artworks" class="slide-cta"><span>View Gallery</span></a>
              </div>
            </div>
          </div>
        `;
        return;
      }

      // Build Slides
      slideshow.innerHTML = slidesData.map((slide: any, index: number) => `
        <div class="slide ${index === 0 ? 'active' : ''}" data-index="${index}">
          <img src="${slide.image}" alt="${slide.title}" class="slide-image" />
          <div class="slide-overlay">
            <div class="slide-content">
              <h2 class="slide-title">${slide.title}</h2>
              <p class="slide-subtitle">${slide.subtitle}</p>
              <a href="${slide.link || '/artworks'}" class="slide-cta">
                <span>Explore</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cta-arrow">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>
      `).join('') + `
        <div class="slider-controls">
          ${slidesData.map((_: any, index: number) => `
            <button class="dot ${index === 0 ? 'active' : ''}" data-index="${index}" aria-label="Go to slide ${index + 1}"></button>
          `).join('')}
        </div>
      `;

      startSliderLogic();

    } catch (err) {
      console.error("Hero slider load failed:", err);
    }
  }

  function startSliderLogic() {
    const slides = document.querySelectorAll('.slide');
    const dots = document.querySelectorAll('.dot');
    let currentSlide = 0;
    let slideInterval: number;

    const showSlide = (index: number) => {
      slides.forEach((slide) => slide.classList.remove('active'));
      dots.forEach((dot) => dot.classList.remove('active'));

      const activeSlide = slides[index];
      const activeDot = dots[index];
      if (activeSlide && activeDot) {
        activeSlide.classList.add('active');
        activeDot.classList.add('active');
      }
      currentSlide = index;
    };

    const nextSlide = () => {
      const nextIndex = (currentSlide + 1) % slides.length;
      showSlide(nextIndex);
    };

    const startAutoplay = () => {
      if (slideInterval) clearInterval(slideInterval);
      slideInterval = window.setInterval(nextSlide, 6000);
    };

    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        const index = parseInt((e.currentTarget as HTMLButtonElement).dataset.index || '0');
        showSlide(index);
        startAutoplay(); 
      });
    });

    startAutoplay();
  }

  // Hook into lifecycle
  document.addEventListener('astro:page-load', initHeroSlider);
</script>
