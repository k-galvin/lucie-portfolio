---
import Layout from '../layouts/Layout.astro';

// Featured items for the hero carousel
const featuredSlides = [
  {
    image: 'https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?w=1600&auto=format&fit=crop',
    title: 'Lucie Galvin',
    subtitle: 'Fine Art, Drawing & Printmaking',
    actionText: 'View Gallery',
    actionLink: '/artworks'
  },
  {
    image: 'https://images.unsplash.com/photo-1541701494587-cb58502866ab?w=1600&auto=format&fit=crop',
    title: 'Vibrant Horizons',
    subtitle: 'Explore the new collection of landscape oil paintings',
    actionText: 'Discover Works',
    actionLink: '/artworks'
  },
  {
    image: 'https://images.unsplash.com/photo-1580136579312-94651dfd596d?w=1600&auto=format&fit=crop',
    title: 'Splashed Pools Exhibition',
    subtitle: 'Upcoming Solo Show at the Royal Academy, July 2026',
    actionText: 'Exhibition Details',
    actionLink: '/exhibitions'
  }
];
---

<Layout>
  <div class="hero-slideshow">
    {featuredSlides.map((slide, index) => (
      <div class={`slide ${index === 0 ? 'active' : ''}`} data-index={index}>
        <img src={slide.image} alt={slide.title} class="slide-image" />
        <div class="slide-overlay">
          <div class="slide-content">
            <h2 class="slide-title">{slide.title}</h2>
            <p class="slide-subtitle">{slide.subtitle}</p>
            <a href={slide.actionLink} class="slide-cta">
              <span>{slide.actionText}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cta-arrow">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    ))}

    <div class="slider-controls">
      {featuredSlides.map((_, index) => (
        <button class={`dot ${index === 0 ? 'active' : ''}`} data-index={index} aria-label={`Go to slide ${index + 1}`}></button>
      ))}
    </div>
  </div>
</Layout>

<style>
  .hero-slideshow {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    background-color: #000; /* Black base for image contrast */
  }

  .slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    z-index: 1;
    transition: opacity 1.2s ease-in-out;
    display: flex;
    align-items: flex-end;
  }

  .slide.active {
    opacity: 1;
    z-index: 2;
  }

  .slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.85); /* Subtle dark overlay to ensure text readability */
    transition: transform 8s ease;
  }

  /* Ken Burns zoom effect on active slide */
  .slide.active .slide-image {
    transform: scale(1.05);
  }

  .slide-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 6% 8%;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 100%);
    color: #ffffff;
    z-index: 3;
    pointer-events: none; /* Let clicks pass through if needed */
  }

  .slide-content {
    max-width: 650px;
    pointer-events: auto; /* Re-enable clicks for child items */
  }

  .slide-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.5rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 10px rgba(0,0,0,0.2);
  }

  .slide-subtitle {
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    font-weight: 300;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 1.5rem;
    text-shadow: 0 1px 5px rgba(0,0,0,0.3);
  }

  .slide-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #ffffff;
    background-color: var(--color-hockney-pink);
    padding: 0.85rem 1.75rem;
    border-radius: 0;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .slide-cta:hover {
    background-color: var(--color-hockney-blue);
    transform: translateY(-2px);
  }

  .cta-arrow {
    transition: transform 0.2s ease;
  }

  .slide-cta:hover .cta-arrow {
    transform: translateX(4px);
  }

  /* Slider Dots */
  .slider-controls {
    position: absolute;
    bottom: 2.5rem;
    right: 3rem;
    display: flex;
    gap: 0.75rem;
    z-index: 10;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.4);
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .dot.active {
    background-color: #ffffff;
    transform: scale(1.3);
  }

  .dot:hover {
    background-color: var(--color-hockney-yellow);
  }

  @media (max-width: 768px) {
    .slide-overlay {
      padding: 2.5rem 1.5rem;
    }
    .slider-controls {
      bottom: 1.5rem;
      right: 1.5rem;
    }
    .slide-cta {
      padding: 0.6rem 1.25rem;
      font-size: 0.8rem;
    }
  }
</style>

<script>
  function initHeroSlider() {
    const slides = document.querySelectorAll('.slide');
    const dots = document.querySelectorAll('.dot');
    let currentSlide = 0;
    let slideInterval: number;

    const showSlide = (index: number) => {
      slides.forEach((slide) => slide.classList.remove('active'));
      dots.forEach((dot) => dot.classList.remove('active'));

      const activeSlide = slides[index];
      const activeDot = dots[index];
      if (activeSlide && activeDot) {
        activeSlide.classList.add('active');
        activeDot.classList.add('active');
      }
      currentSlide = index;
    };

    const nextSlide = () => {
      const nextIndex = (currentSlide + 1) % slides.length;
      showSlide(nextIndex);
    };

    const startAutoplay = () => {
      stopAutoplay();
      slideInterval = window.setInterval(nextSlide, 6000);
    };

    const stopAutoplay = () => {
      if (slideInterval) {
        clearInterval(slideInterval);
      }
    };

    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        const index = parseInt((e.currentTarget as HTMLButtonElement).dataset.index || '0');
        showSlide(index);
        startAutoplay(); // Reset timer on interaction
      });
    });

    // Start
    startAutoplay();
  }

  // Hook into lifecycle
  document.addEventListener('astro:page-load', initHeroSlider);
</script>
